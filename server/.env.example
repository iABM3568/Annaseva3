# Copy to .env and fill in real values. NEVER commit .env.
PORT=5000
# Dev database name ends in _dev (the seed and cleanup scripts refuse other databases without --force)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/annaseva_dev?retryWrites=true&w=majority
# Long random secret, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=a-long-random-string
# Exact front-end origin allowed by CORS and Socket.IO (no trailing slash)
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Optional: general API requests per 15 minutes per IP (default 1000)
RATE_LIMIT_MAX=1000
# Optional: password for the seeded demo accounts (default Demo@12345, dev only)
DEMO_PASSWORD=Demo@12345
