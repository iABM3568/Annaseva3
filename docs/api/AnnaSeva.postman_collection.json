    {
      "key": "ngoToken",
      "value": ""
    },
    {
      "key": "preparedAt",
      "value": ""
    },
    {
      "key": "expiresAt",
      "value": ""
    },
    {
      "key": "pastPrepared",
      "value": ""
    },
    {
      "key": "pastExpires",
      "value": ""
    },
    {
      "key": "expires3Days",
      "value": ""
    },
    {
      "key": "futurePrepared",
      "value": ""
    }
