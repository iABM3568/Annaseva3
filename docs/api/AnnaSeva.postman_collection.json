    {
      "name": "Listings (Day 3)",
      "description": "Day 3 test table. Set donorToken and ngoToken collection variables first (log in as each). Dates are generated by the folder pre-request script; in Thunder Client, if scripts don't run, paste ISO times (expiresAt within 24 h) into the date variables.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Fresh dates on every request, so the 24-hour rule never makes these tests stale.",
              "const iso = (h) => new Date(Date.now() + h * 3600 * 1000).toISOString();",
              "pm.collectionVariables.set('preparedAt', iso(-1));",
              "pm.collectionVariables.set('expiresAt', iso(5));",
              "pm.collectionVariables.set('pastPrepared', iso(-5));",
              "pm.collectionVariables.set('pastExpires', iso(-1));",
              "pm.collectionVariables.set('expires3Days', iso(72));",
              "pm.collectionVariables.set('futurePrepared', iso(3));"
            ]
          }
        }
      ],
